class McpIsolationError(Exception):
    """Codex could not confirm that the MCP servers and related features were disabled."""


def _toml_basic_key(name):
    """Encode a server name as a TOML basic string key."""
    parts = ['"']
    for char in name:
        codepoint = ord(char)
        if char in ('"', "\\"):
            parts.append("\\" + char)
        elif codepoint < 0x20 or codepoint == 0x7F:
            parts.append(f"\\u{codepoint:04X}")
        else:
            parts.append(char)
    parts.append('"')
    return "".join(parts)


def mcp_off_args(cwd=None, env=None):
    """Build and verify the switches that disable MCP servers and related features."""
    def run_listing(command, args):
        listing = " ".join(command[:3])
        try:
            result = subprocess.run(
                [*command, *args],
                cwd=cwd, env=env, capture_output=True, text=True, timeout=MCP_LIST_TIMEOUT,
            )
        except subprocess.TimeoutExpired as exc:
            raise McpIsolationError(
                f"{listing} timed out after {exc.timeout}s. "
                "An enabled HTTP MCP server may be slow to respond to OAuth discovery."
            ) from exc
        except OSError as exc:
            raise McpIsolationError(f"Cannot run {listing}: {exc}") from exc
        except UnicodeError as exc:
            raise McpIsolationError(f"Cannot decode {listing} output: {exc}") from exc
        if result.returncode != 0:
            detail = result.stderr.strip() or "no stderr output"
            raise McpIsolationError(f"{listing} exited with code {result.returncode}: {detail}")
        return result.stdout

    def list_servers(args):
        output = run_listing(["codex", "mcp", "list", "--json"], args)
        try:
            servers = json.loads(output)
        except (ValueError, RecursionError) as exc:
            raise McpIsolationError(f"Invalid JSON from codex mcp list: {exc}") from exc
        if not isinstance(servers, list) or not all(
            isinstance(server, dict) and isinstance(server.get("name"), str)
            and isinstance(server.get("enabled"), bool) for server in servers
        ):
            raise McpIsolationError(
                "Invalid codex mcp list output: expected a JSON list of objects with a string name and a boolean enabled"
            )
        return servers

    args = list(MCP_BASE_ARGS)
    entries = [
        _toml_basic_key(server["name"]) + "={enabled=false}"
        for server in list_servers(MCP_BASE_ARGS) if server["enabled"]
    ]
    if entries:
        args.extend(("-c", "mcp_servers={" + ",".join(entries) + "}"))

    remaining = [repr(server["name"]) for server in list_servers(args) if server["enabled"]]
    if remaining:
        raise McpIsolationError("MCP servers still enabled: " + ", ".join(remaining))

    feature_output = run_listing(["codex", "features", "list"], args)
    if not feature_output.strip():
        raise McpIsolationError("Invalid codex features list output: no non-blank lines")
    features_to_disable = {
        value[len("features."):-len("=false")]
        for flag, value in zip(MCP_BASE_ARGS, MCP_BASE_ARGS[1:])
        if flag == "-c" and value.startswith("features.") and value.endswith("=false")
    }
    for line in feature_output.splitlines():
        fields = line.split()
        if not fields:
            continue
        if len(fields) < 2 or fields[-1] not in ("true", "false"):
            raise McpIsolationError(f"Invalid codex features list output: {line!r}")
        if fields[0] in features_to_disable and fields[-1] == "true":
            raise McpIsolationError(f"Codex feature still enabled: {fields[0]}")
    return args


def _model_config(env=None):
    """Return the effective review model and reasoning effort."""
    if env is None:
        env = os.environ
    model = env.get("CODEX_REVIEW_MODEL") or REVIEW_MODEL
    effort = env.get("CODEX_REVIEW_EFFORT") or REVIEW_EFFORT
    return model, effort


def model_args(env=None):
    """Build explicit Codex configuration arguments for review runs."""
    return _model_args(*_model_config(env))


def daybreak_model_args(env=None):
    """Build Codex configuration arguments for the manual Daybreak command."""
    if env is None:
        env = os.environ
    model = env.get("CODEX_REVIEW_DAYBREAK_MODEL") or DAYBREAK_MODEL
    effort = env.get("CODEX_REVIEW_DAYBREAK_EFFORT") or DAYBREAK_EFFORT
    return _model_args(model, effort)


def _model_args(model, effort):
    return [
        "-c", f'model="{model}"',
        "-c", f'review_model="{model}"',
        "-c", f'model_reasoning_effort="{effort}"',
    ]


def failure_summary(stderr_text, limit=1500):
    """Error lines plus the tail of Codex stderr: the cause is printed last, after the banner."""
    text = (stderr_text or "").strip()
    if not text:
        return ""
    marked = [line for line in text.splitlines()
              if re.search(r"\bERROR\b|error:|flagged|cyber_policy|usage limit|rate limit|quota", line, re.I)]
    tail = text if len(text) <= limit else "..." + text[-limit:]
    parts = (["\n".join(marked[-5:])] if marked else []) + [tail]
    return "\n---\n".join(parts)[:2000]


def _session_id(stderr_text):
    """Read the first session ID reported by Codex, ignoring ANSI codes."""
    text = re.sub(r"\x1b\[[0-9;?]*[ -/]*[@-~]", "", stderr_text or "")
    session = re.search(r"(?m)^[ \t]*session id:[ \t]+(\S+)[ \t]*\r?$", text)
    return session[1] if session else None


def _session_rollout_paths(stderr_text, codex_home=None):
    """Find rollout paths for the first session ID reported by Codex."""
    session_id = _session_id(stderr_text)
    if session_id is None:
        return

    home = Path(codex_home or os.environ.get("CODEX_HOME") or "~/.codex").expanduser()
    suffix = f"{session_id}.jsonl"
    for path in (home / "sessions").rglob("rollout-*.jsonl"):
        if path.name.endswith(suffix):
            yield path


def _session_rollout_lines(stderr_text, codex_home=None):
    for path in _session_rollout_paths(stderr_text, codex_home):
        try:
            if path.is_file():
                with path.open(encoding="utf-8", errors="replace") as rollout:
                    yield from rollout
        except OSError:
            continue


def is_cyber_policy_refusal(returncode, stderr_text, codex_home=None) -> bool:
    """Identify a failed review whose session journal records a cyber policy refusal."""
    if not returncode:
        return False
    for line in _session_rollout_lines(stderr_text, codex_home):
        try:
            event = json.loads(line)
        except (ValueError, RecursionError):
            continue
        if not isinstance(event, dict) or event.get("type") != "event_msg":
            continue
        payload = event.get("payload")
        if not isinstance(payload, dict) or payload.get("type") != "task_complete":
            continue
        error = payload.get("error")
        if isinstance(error, dict) and error.get("codex_error_info") == "cyber_policy":
            return True
    return False


def report_codex_failure(returncode, stderr_text):
    summary = failure_summary(stderr_text)
    detail = f": {summary}" if summary else ""
    print(f"\nCodex failed (exit {returncode}){detail}", file=sys.stderr)


def daybreak_review_prompt(commit) -> str:
    """Build a code review prompt for the exact commit."""
    if commit is None:
        raise ValueError("the Daybreak review needs a commit")
    return (
        "Review only the commit shown by `git show -m --first-parent "
        f"--end-of-options {shlex.quote(commit)} --`. "
        "Do not modify any files; report findings only. "
        "Report only actionable defects introduced by this change, in descending severity. "
        "Use one of [P0], [P1], [P2], or [P3] for each finding. "
        "Start each finding with a line in the form `- [P0|P1|P2|P3] <title> — <path>:<line>`. "
        "Follow that line with a paragraph describing a concrete scenario where the defect causes a failure. "
        "If there are no defects, explicitly say so."
    )


def daybreak_command(mode, *, commit=None, prompt=None, env=None, mcp_args=()):
    """Build the Daybreak Blue command to print for a manual review."""
    if mode == "commit":
        prompt = daybreak_review_prompt(commit)
    elif mode != "arch":
        raise ValueError(f"unsupported Daybreak review mode: {mode}")
    return [
        "codex", "exec", *daybreak_model_args(env), *mcp_args, "--cyber-access-program",
        DAYBREAK_PROGRAM, "-s", "read-only", prompt,
    ]


def report_cyber_policy_refusal(stderr_text, mode, target, *, pin_sha=None, mcp_args=()):
    session_id = _session_id(stderr_text)
    print(f"Review stopped by OpenAI's cyber_policy filter (session id: {session_id}).", file=sys.stderr)
    if mode == "unpushed":
        return

    command = (
        DAYBREAK_GIT_ENV_PREFIX + "python3 -I -c " + shlex.quote(MCP_GUARD_CHECK)
        + " " + shlex.join(mcp_args) + " && "
        + DAYBREAK_GIT_ENV_PREFIX + shlex.join(daybreak_command(mode, **target, mcp_args=mcp_args))
    )
    worktree_sha = target["commit"] if mode == "commit" else pin_sha
    if worktree_sha is not None:
        print(
            "From the original checkout, create a fresh detached worktree. Replace <dir> with a new path.\n"
            f"  {DAYBREAK_GIT_ENV_PREFIX}git -c core.hooksPath=/dev/null worktree add --detach "
            f"<dir> {shlex.quote(worktree_sha)}\n"
            "Check that the worktree is clean. This command should produce no output.\n"
            f"  {DAYBREAK_GIT_ENV_PREFIX}git -C <dir> status --porcelain\n"
            "Run the following Daybreak Blue command from inside that worktree.\n"
            f"{command}\n"
            "After the review, return to the original checkout and remove the worktree.\n"
            f"  {DAYBREAK_GIT_ENV_PREFIX}git worktree remove <dir>",
            file=sys.stderr,
        )
    else:
        print(f"Run the following Daybreak Blue command manually.\n{command}", file=sys.stderr)
    print(
        "WARNING — OpenAI may use the Daybreak session for training.\n"
        "WARNING — The Daybreak agent can read any file on this machine.\n"
        "WARNING — The command starts Codex only if `codex mcp list` with the same switches "
        "shows no enabled MCP server and `codex features list` confirms the feature overrides "
        "in the directory where it runs.\n"
        "WARNING — An `invalid transport` error from the server check means this directory lacks an MCP server "
        "the review switched off (for example, one from an uncommitted project config). "
        "Rerun the review with `--pin`.\n"
        "WARNING — The manual review does not count toward the deploy gate.",
        file=sys.stderr,
    )


def build_cmd(mode, *, commit=None, base=None, prompt=None, env=None, mcp_args=()):
    """Build a Codex command for one of the supported review modes."""
    args = [*model_args(env), "-c", "daybreak=false", *mcp_args]
    if mode == "commit":
        return ["codex", "review", *args, "--commit", commit]
    if mode == "unpushed":
        return ["codex", "review", *args, "--base", base]
    if mode == "arch":
        return ["codex", "exec", *args, prompt]
    raise ValueError(f"unknown review mode: {mode}")


def git_resolve_commit(ref, *, quiet=False):
    """Resolve a commit ref to its full object ID."""
    cmd = ["git", "rev-parse", "--verify", "--end-of-options", f"{ref}^{{commit}}"]
    return subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL if quiet else None).strip()


def git_unpushed_base():
    """Find the base ref for unpushed commits (remote tracking branch or origin/HEAD)."""
    try:
        base = subprocess.check_output(
            ["git", "rev-parse", "--abbrev-ref", "@{push}"],
            text=True, stderr=subprocess.DEVNULL
        ).strip()
        if base:
            return base
    except subprocess.CalledProcessError:
        pass
    try:
        branch = subprocess.check_output(
            ["git", "rev-parse", "--abbrev-ref", "HEAD"],
            text=True, stderr=subprocess.DEVNULL
        ).strip()
        return f"origin/{branch}"
    except subprocess.CalledProcessError:
        return "origin/master"


def git_unpushed_count(base):
    """Count commits ahead of base."""
    try:
        output = subprocess.check_output(
            ["git", "rev-list", "--count", f"{base}..HEAD"],
            text=True, stderr=subprocess.DEVNULL
        ).strip()
        return int(output)
    except (subprocess.CalledProcessError, ValueError):
        return 0


def git_changed_files(commit="HEAD"):
    try:
        lines = subprocess.check_output(
            ["git", "diff-tree", "--no-commit-id", "--name-only", "-r", "--root", "-m", commit],
            text=True, stderr=subprocess.DEVNULL
        ).strip().splitlines()
        return list(dict.fromkeys(lines))
    except subprocess.CalledProcessError:
        return []


def pinned_worktree_matches(pin_sha):
    """Check that the detached worktree is clean and still at the pin."""
    try:
        head = subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip()
        return head == pin_sha and not subprocess.check_output(
            ["git", "status", "--porcelain", "--untracked-files=all"]
        )
    except subprocess.CalledProcessError:
        return False


def main():
    parser = argparse.ArgumentParser(description="Run Codex review")
    parser.add_argument("--arch", action="store_true", help="Architecture review mode")
    parser.add_argument("--commit", help="Commit to review (default: HEAD)")
    parser.add_argument("--unpushed", action="store_true", help="Review all unpushed commits vs origin")
    parser.add_argument("--print-model", action="store_true",
                        help="Print the configured review model and effort, then exit")
    parser.add_argument("--pin", metavar="SHA",
                        help="Run inside a temporary detached worktree at SHA (auto-cleanup). "
                             "Use in shared repos so a parallel session's HEAD move cannot swap "
                             "the reviewed commit. Implies --commit SHA unless --commit is given.")
    args = parser.parse_args()

    if args.print_model:
        model, effort = _model_config()
        print(f"{model} {effort}")
        sys.exit(0)

    record = {"reason": "review did not complete"} if args.pin and not args.arch else None
    try:
        run_review(args, record)
    except Exception as e:
        if record is not None:
            record["reason"] = str(e)
        print(f"ERROR: {e}", file=sys.stderr)
        sys.exit(1)
    finally:
        if record is not None:
            reason = ("the pinned worktree does not match the pin" if record.get("pin_mismatch")
                      else record["reason"])
            if reason is None:
                try:
                    entry = {
                        "sha": record["sha"],
                        "mode": "unpushed" if args.unpushed else "commit",
                        "repo": record["repo"],
                        "at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
                        "completed": True,
                    }
                    if args.unpushed:
                        entry["base"] = record["base"]
                    record["path"].parent.mkdir(parents=True, exist_ok=True)
                    with record["path"].open("a") as verdicts:
                        verdicts.write(json.dumps(entry) + "\n")
                except Exception as e:
                    reason = f"cannot append review record: {e}"
            if reason is not None:
                print("WARNING: review record not written: " + " ".join(reason.splitlines()),
                      file=sys.stderr)


def run_review(args, record):
    """Run the review, marking completion only after successful output consumption."""
    start_dir = Path.cwd()
    if record is not None:
        verdict_path = Path(os.environ.get(
            "CODEX_REVIEW_VERDICTS", "~/.local/state/codex-review/verdicts.jsonl"
        )).expanduser()
        record["path"] = start_dir / verdict_path

    # Clean previous output
    if os.path.exists(OUTPUT_FILE):
        os.remove(OUTPUT_FILE)

    # --pin: create a detached worktree at SHA and run the whole review from inside it.
    # Cleanup is registered via atexit so every exit path (timeout, codex failure, Ctrl-C)
    # removes the worktree from the original directory with the source Git environment.
    pin_sha = None
    pin_mismatch = False
    if args.pin:
        import atexit
        import tempfile
        os.environ["GIT_NO_REPLACE_OBJECTS"] = "1"
        orig_repo = subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"], text=True
        ).strip()
        pin_sha = git_resolve_commit(args.pin)
        # Resolve all refs in the source checkout before detaching or moving HEAD.
        if args.commit is None:
            args.commit = pin_sha
        else:
            args.commit = git_resolve_commit(args.commit)
        if record is not None:
            record.update(sha=pin_sha, repo=orig_repo)
            if args.commit != pin_sha:
                record["reason"] = "--commit resolves to a different commit than --pin"
        if args.unpushed and not args.arch:
            try:
                base = git_resolve_commit(git_unpushed_base(), quiet=True)
            except subprocess.CalledProcessError:
                base = git_resolve_commit("origin/HEAD")
            if record is not None:
                # Codex starts the diff at the common ancestor with the pin.
                record["base"] = subprocess.check_output(
                    ["git", "merge-base", base, pin_sha], text=True
                ).strip()
        tmpdir = tempfile.mkdtemp(prefix="codex-pin-")
        try:
            subprocess.check_output(
                ["git", "-c", "core.hooksPath=/dev/null",
                 "worktree", "add", "--detach", tmpdir, pin_sha],
                stderr=subprocess.STDOUT, text=True)
        except subprocess.CalledProcessError as e:
            print(f"ERROR: cannot pin worktree at {args.pin}: {e.output.strip()[:300]}",
                  file=sys.stderr)
            sys.exit(1)

        source_env = os.environ.copy()

        def _cleanup_pin():
            subprocess.run(["git", "worktree", "remove", "--force", tmpdir],
                           cwd=start_dir, env=source_env,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        atexit.register(_cleanup_pin)
        os.chdir(tmpdir)
        for name in ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_COMMON_DIR",
                     "GIT_OBJECT_DIRECTORY"):
            os.environ.pop(name, None)
        if record is not None:
            pin_mismatch = not pinned_worktree_matches(pin_sha)
            record["pin_mismatch"] = pin_mismatch
        print(f"Pinned worktree at {pin_sha[:12]} ({tmpdir})")

    if args.commit is None:
        args.commit = "HEAD"

    if args.arch:
        changed = git_changed_files(args.commit)
        prompt = ARCH_PROMPT
        if changed:
            prompt = f"Focus on these files from the last commit: {', '.join(changed)}. {prompt}"
        mode, target = "arch", {"prompt": prompt}
        print(f"Running architecture review ({len(changed)} files)...")
    elif args.unpushed:
        if not args.pin:
            base = git_unpushed_base()
        count = git_unpushed_count(base)
        if count == 0 and not pin_mismatch:
            if record is not None:
                record["reason"] = "no unpushed commits to review"
            print(f"No unpushed commits vs {base}")
            sys.exit(0)
        mode, target = "unpushed", {"base": base}
        print(f"Running code review on {count} unpushed commits vs {base}...")
    else:
        if not args.pin:
            try:
                args.commit = git_resolve_commit(args.commit, quiet=True)
            except subprocess.CalledProcessError:
                pass
        changed = git_changed_files(args.commit)
        mode, target = "commit", {"commit": args.commit}
        print(f"Running code review on {args.commit[:8]} ({len(changed)} files)...")

    model, effort = _model_config()
    print(f"Model: {model} / {effort}", flush=True)
    mcp_args = mcp_off_args()
    returncode, stdout_lines, stderr_text = run_codex(build_cmd(mode, **target, mcp_args=mcp_args), record)

    if returncode != 0:
        if record is not None:
            record["reason"] = f"Codex exited with code {returncode}"
        if is_cyber_policy_refusal(returncode, stderr_text):
            report_cyber_policy_refusal(stderr_text, mode, target, pin_sha=pin_sha, mcp_args=mcp_args)
            sys.exit(1)
        if stderr_text:
            report_codex_failure(returncode, stderr_text)
        if not stdout_lines:
            sys.exit(1)

    if not stdout_lines:
        if record is not None:
            record["reason"] = "Codex output is empty"
        print("No output from Codex", file=sys.stderr)
        sys.exit(1)

    if record is not None and returncode == 0 and record["reason"] == "review did not complete":
        if not pinned_worktree_matches(pin_sha):
            record["pin_mismatch"] = True
        elif not record["pin_mismatch"]:
            record["reason"] = None if any(line.strip() for line in stdout_lines) else "Codex output is empty"


def run_codex(cmd, record):
    """Stream one Codex command and return its exit code, stdout lines and stderr."""

    # Stream output in real-time while capturing to file.
    # capture_output=True buffers everything — on large codebases with gpt-5.4/xhigh
    # this means 7-10 min of silence before any output, making it look hung.
    import threading

    stdout_lines = []
    stderr_chunks = []
    stdout_complete = threading.Event()
    read_errors = []

    try:
        with open(OUTPUT_FILE, "w") as outf:
            proc = subprocess.Popen(
                cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                env=os.environ.copy(),
            )

            # Read stdout in worker thread (blocks on readline)
            def read_stdout():
                try:
                    for line in proc.stdout:
                        sys.stdout.write(line)
                        sys.stdout.flush()
                        outf.write(line)
                        outf.flush()
                        stdout_lines.append(line)
                    stdout_complete.set()
                except Exception as e:
                    if record is None:
                        raise
                    read_errors.append(e)

            # Drain stderr in background thread to prevent pipe buffer deadlock
            def drain_stderr():
                try:
                    for line in proc.stderr:
                        stderr_chunks.append(line)
                except Exception as e:
                    if record is None:
                        raise
                    read_errors.append(e)

            t_out = threading.Thread(target=read_stdout, daemon=True)
            t_err = threading.Thread(target=drain_stderr, daemon=True)
            t_out.start()
            t_err.start()

            # Main thread = watchdog
            t_out.join(timeout=TIMEOUT)
            if t_out.is_alive():
                if record is not None:
                    record["reason"] = f"Codex timed out after {TIMEOUT}s"
                proc.kill()
                proc.wait()
                print(f"\nERROR: Codex timed out after {TIMEOUT}s", file=sys.stderr)
                sys.exit(1)

            if record is not None and not stdout_complete.is_set():
                # A failed reader cannot drain the pipe while Codex is still writing.
                proc.kill()
            proc.wait()
            # A descendant may keep stderr open after Codex has exited.
            t_err.join(timeout=5)
    except Exception as e:
        if record is not None:
            record["reason"] = str(e)
        print(f"ERROR: {e}", file=sys.stderr)
        sys.exit(1)

    if record is not None and (read_errors or not stdout_complete.is_set()):
        reason = (f"error reading Codex output: {read_errors[0]}" if read_errors
                  else "Codex output was not read to the end")
        record["reason"] = reason
        print(f"ERROR: {reason}", file=sys.stderr)
        sys.exit(1)

    return proc.returncode, stdout_lines, "".join(stderr_chunks).strip()


